# Meta (Facebook) Pixel.
#
# The pixel only loads when VERCEL_ENV === 'production' AND the browser is on one
# of the hosts in src/shared/utils/analyticsEnv.ts. Leaving this unset disables
# the pixel entirely, so it must be set on the Vercel *production* environment
# before this branch is deployed — and must NOT be set on preview/development,
# where it would be inert anyway.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API access token. Server-side only — no NEXT_PUBLIC_ prefix,
# so it never reaches the client bundle. Without it the /api/facebook-events
# route returns 503 instead of sending anything.
FACEBOOK_ACCESS_TOKEN=

# ── Web sessions (see src/features/auth/lib/webSession.ts) ──────────────────
# "true": sign-in goes through this site's server, which keeps the refresh
# token in an HttpOnly cookie, and the page holds only a 30-minute access
# token. Set it only once WEB_SESSION_KEY is set here AND the backend has
# WebSession:ServerKey (same value) and the WebSessions table.
NEXT_PUBLIC_WEB_SESSIONS=
# Server-only. Must equal the backend's WebSession:ServerKey. Never NEXT_PUBLIC_.
WEB_SESSION_KEY=
